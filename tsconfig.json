{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "src/**/*.ts",
        "src/website",
        "src/**/*.js"
    ]
}